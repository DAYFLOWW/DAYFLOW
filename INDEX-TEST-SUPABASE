der:0;border-radius:12px;padding:11px 14px;font-weight:800;color:#19142b;background:linear-gradient(100deg,var(--pink),var(--violet));box-shadow:0 5px 18px #a78bfa20}.btn.cyan{background:linear-gradient(100deg,var(--cyan),var(--green))}.btn.secondary{background:var(--panel2);border:1px solid var(--line);box-shadow:none;color:var(--text)}.btn.ghost{background:transparent;border:1px solid var(--line);box-shadow:none;color:var(--text)}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.actions .btn{flex:1}.hint{font-size:11px;color:var(--muted);margin:9px 0 0;line-height:1.55}.tasklist{display:flex;flex-direction:column;gap:9px}.task{display:flex;align-items:flex-start;gap:10px;padding:13px;border-radius:15px;border:1px solid var(--line);background:#201d35}.check{appearance:none;flex:0 0 20px;width:20px;height:20px;border:1px solid #706a91;border-radius:7px;margin-top:1px}.check:checked{background:var(--green);border-color:var(--green)}.check:checked:after{content:'✓';display:block;text-align:center;line-height:18px;color:#14271c;font-weight:900}.taskbody{flex:1;min-width:0}.taskname{font-weight:750;overflow-wrap:anywhere}.task.done .taskname{text-decoration:line-through;color:var(--muted)}.meta{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.tag{font-size:10px;border-radius:7px;padding:4px 7px;background:#ffffff0c;color:#c9c5df}.tag.pink{color:#ffacd0;background:#ff6fae18}.tag.cyan{color:#8ef1fb;background:#67e8f918}.tag.yellow{color:#f9df87;background:#f9d66b15}.tag.green{color:#a4f2c1;background:#8be7b018}.taskbuttons{display:flex;gap:3px}.tinybtn{background:transparent;border:1px solid var(--line);border-radius:8px;color:var(--muted);padding:5px 7px;font-size:11px}.empty{border:1px dashed var(--line);border-radius:15px;padding:20px;text-align:center;color:var(--muted);font-size:13px}.proposal{border:1px solid #67e8f955;background:#122633;border-radius:16px;padding:14px;margin-top:12px}.proposal h3{margin:0 0 6px;font-size:15px}.proposal p{color:#b8d6d