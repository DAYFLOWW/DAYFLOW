function toMin(s){if(!s)return null;const [h,m]=s.split(':').map(Number);return h*60+m}
function fmt(m){m=((m%1440)+1440)%1440;return pad(Math.floor(m/60))+':'+pad(m%60)}
function occurrence(t,date){if(t.date===date)return true;if(!t.repeatMonthly||date<t.date)return false;const d=parseDate(date),target=Math.min(t.monthDay,new Date(d.getFullYear(),d.getMonth()+1,0).getDate());return d.getDate()===target}
