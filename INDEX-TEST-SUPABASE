1;max-width:170px;background:transparent;border:1px solid transparent;color:var(--muted);border-radius:12px;padding:9px 6px;font-size:11px}nav button.active{color:var(--text);background:linear-gradient(120deg,#ff6fae24,#a78bfa24);border-color:#a78bfa55}.toast{position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:20;background:#24213b;border:1px solid var(--line);border-radius:12px;padding:10px 14px;box-shadow:0 8px 28px #0005;font-size:12px;max-width:90vw}.footer-note{font-size:10px;color:#85809f;margin:20px 2px 0}
