function renderCalendar(){const year=viewMonth.getFullYear(),month=viewMonth.getMonth();$('monthTitle').textContent=viewMonth.toLocaleDateString('es-ES',{month:'long',year:'numeric'});const first=new Date(year,month,1),offset=(first.getDay()+6)%7,days=new Date(year,month+1,0).getDate(),prevDays=new Date(year,month,0).getDate();let html=weekNames.map(n=>`<div class="weekday">${n}</div>`).join('');for(let i=0;i<42;i++){let num,dt,other=false;if(i<offset){num=prevDays-offset+i+1;dt=new Date(year,month-1,num);other=true}else if(i>=offset+days){num=i-offset-days+1;dt=new Date(year,month+1,num);other=true}else{num=i-offset+1;dt=new Date(year,month,num)}const key=dateKey(dt),has=tasks.some(t=>occurrence(t,key)),cls=['day',other?'muted':'',key===selectedDate?'selected':'',key===dateKey(today)?'today':''].filter(Boolean).join(' ');html+=`<button class="${cls}" data-date="${key}" aria-label="${esc(pretty(key))}">${num}${has?'<span class="dot"></span>':''}</button>`} $('calendar').innerHTML=html;document.querySelectorAll('[data-date]').forEach(b=>b.addEventListener('click',()=>selectDate(b.dataset.date)))}
