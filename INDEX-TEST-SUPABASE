ap:wrap;margin-top:8px}.onboard-days label{display:flex;gap:4px;align-items:center;padding:6px 8px;border-radius:9px;background:#f1f2fb;font-size:11px}.onboard-days input{accent-color:#7567f8}.hidden{display:none!important}
